        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Define os estilos e classes UML\n    classDef actorStyle fill:#fff,stroke:#333,stroke-width:2px;\n    classDef useCaseStyle fill:#f9f9f9,stroke:#333,stroke-width:1.5px,rx:15,ry:15;\n    classDef parentUC fill:#e1f5fe,stroke:#0288d1,stroke-width:1.5px,rx:15,ry:15;\n\n    %% Atores e Generalização de Atores\n    User[\&quot; Usuário (Geral)\&quot;]:::actorStyle\n    Reader[\&quot; Leitor\&quot;]:::actorStyle\n    Lib[\&quot; Bibliotecário\&quot;]:::actorStyle\n\n    Reader -- \&quot;é um tipo de\&quot; --&gt; User\n    Lib -- \&quot;é um tipo de\&quot; --&gt; User\n\n    %% Casos de Uso principais\n    Consultar[\&quot;Consultar Acervo\&quot;]:::useCaseStyle\n    Reservar[\&quot;Reservar Livro\&quot;]:::useCaseStyle\n    Emprestar[\&quot;Emprestar Livro\&quot;]:::useCaseStyle\n    Bloquear[\&quot;Bloquear Leitor\&quot;]:::useCaseStyle\n    Identificar[\&quot;Identificar Leitor\&quot;]:::useCaseStyle\n    Verificar[\&quot;Verificar Pendências\&quot;]:::useCaseStyle\n    Notificar[\&quot;Notificar Atraso\&quot;]:::useCaseStyle\n\n    %% Caso de uso Pai (Generalização Nível A)\n    Transacao[\&quot;Realizar Transação de Livro\&quot;]:::parentUC\n\n    %% Relações include (Seta do Base -&gt; Incluído)\n    Emprestar -. \&quot;«include»\&quot; .-&gt; Identificar\n    Reservar -. \&quot;«include»\&quot; .-&gt; Identificar\n    Bloquear -. \&quot;«include»\&quot; .-&gt; Identificar\n    Emprestar -. \&quot;«include»\&quot; .-&gt; Verificar\n\n    %% Relações extend (Seta do Extensão -&gt; Base)\n    Reservar -. \&quot;«extend»\&quot; .-&gt; Consultar\n    Notificar -. \&quot;«extend»\&quot; .-&gt; Emprestar\n\n    %% Generalização entre Casos de Uso (Nível A)\n    Emprestar -- \&quot;herda de\&quot; --&gt; Transacao\n    Reservar -- \&quot;herda de\&quot; --&gt; Transacao&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Jm18CJizkWB_kpyoByem-33">
